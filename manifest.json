{
  "manifest_version": 3,
  "name": "Explain Agent",
  "version": "1.0",
  "description": "Select any text and get an expert explanation.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"] }
  ]
}